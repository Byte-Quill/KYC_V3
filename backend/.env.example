# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ---- Database (MongoDB) ----
# Local dev:  mongodb://localhost:27017/kyc
# Atlas prod: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kyc
MONGODB_URI=mongodb://localhost:27017/kyc

# ---- Supabase ----
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Storage bucket for KYC documents (create it in the dashboard or via CLI).
SUPABASE_STORAGE_BUCKET=kyc-documents
